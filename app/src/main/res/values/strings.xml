	<!-- chromatic run recording (RunRecorder) -->
	<string name="menu_run">Record chromatic run</string>
	<string name="run_title">Record a chromatic run</string>
	<string name="run_help">For improving the note detection on real pipes. Set the first key as the note shown, then play every key in turn: hold it about 3 s, release it, and tap semi+ for the next one (also in mixture mode). semi&#8722; plays a key again. Follow is off during the run; the note shown is the key played. Tap the row of the stop&#8217;s footage to record how far each pipe is off. Stop it in the bar at the top. Leaving the app or switching the screen off ends the run.</string>
