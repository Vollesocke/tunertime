<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android">
    <PreferenceCategory android:title="@string/cat_main">
	<CheckBoxPreference
		android:key="organ_mode"
		android:title="@string/organ_mode"
		android:summary="@string/organ_mode_summary"
		android:defaultValue="false" />
	<CheckBoxPreference
		android:key="german_names"
		android:title="@string/german_names"
		android:summaryOn="@string/german_names_on"
		android:summaryOff="@string/german_names_off"
		android:defaultValue="false" />
	<!-- Android 13+ keeps this as the per-app language (Lang.java) -->
	<ListPreference
		android:key="language"
		android:title="@string/language"
		android:summary="%s"
		android:entries="@array/language_name"
		android:entryValues="@array/language_value"
		android:defaultValue="system" />
    </PreferenceCategory>
    <PreferenceCategory android:title="@string/cat_audio">
	<ListPreference
		android:key="audio_source"
		android:title="@string/audio_source"
		android:summary="%s"
		android:entries="@array/audio_source_name"
		android:entryValues="@array/audio_source_value"
		android:defaultValue="auto" />
    </PreferenceCategory>
    <PreferenceCategory android:key="strobe_category"
		android:title="@string/cat_strobe">
	<ListPreference
		android:key="strobe_color"
		android:title="@string/strobe_colors"
		android:summary="%s"
		android:entries="@array/color_name"
		android:entryValues="@array/color_value"
		android:defaultValue="batlow" />
	<!-- summaries: the rows chosen (Settings.java) -->
	<org.galexander.tunertime.DirectMultiSelectListPreference
		android:key="harmonics"
		android:title="@string/harmonics"
		android:entries="@array/harmonics"
		android:entryValues="@array/harmonics"
		android:defaultValue="@array/harmonics_default" />
	<!-- shown instead of "harmonics" in organ mode (Settings.java) -->
	<org.galexander.tunertime.DirectMultiSelectListPreference
		android:key="organ_footages"
		android:title="@string/footages"
		android:entries="@array/footage_name"
		android:entryValues="@array/footage_value"
		android:defaultValue="@array/footage_default" />
    </PreferenceCategory>
    <PreferenceCategory android:title="@string/cat_debug">
	<!-- two ways for mixture mode to follow the key, to compare in
	     practice (TunerTime.on_pitch) -->
	<CheckBoxPreference
		android:key="mixture_focus_follow"
		android:title="@string/mixture_focus_follow"
		android:summaryOn="@string/mixture_focus_follow_on"
		android:summaryOff="@string/mixture_focus_follow_off"
		android:defaultValue="false" />
	<CheckBoxPreference
		android:key="debug_rec"
		android:title="@string/debug_rec"
		android:summary="@string/debug_rec_summary"
		android:defaultValue="@bool/debug_rec_default" />
    </PreferenceCategory>
</PreferenceScreen>
