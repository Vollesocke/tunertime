<?xml version="1.0" encoding="utf-8"?>
<!-- mixture mode (organ mode, in place of stretch): laid out like note
     mode, the semitone buttons on the left, so the next key is one tap
     away; measure and reset on the right, the readout between -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="fill_parent"
    android:layout_height="fill_parent">
    <LinearLayout
	android:layout_width="fill_parent"
	android:layout_height="1dp"
	android:layout_weight="1"
	android:orientation="horizontal">
	<Button android:id="@+id/mixture_semi_plus"
	    style="@style/Tuner.Button.Panel"
	    android:layout_width="1dp"
	    android:layout_height="fill_parent"
	    android:layout_weight="1"
	    android:text="@string/semi_plus"
	    android:onClick="mixture_semi_incr" />
	<Button
	    style="@style/Tuner.Button.Panel"
	    android:layout_width="1dp"
	    android:layout_height="fill_parent"
	    android:layout_weight="1"
	    android:text="@string/oct_plus"
	    android:onClick="mixture_oct_incr" />
	<Button android:id="@+id/mixture_measure"
	    style="@style/Tuner.Button.Panel"
	    android:layout_width="1dp"
	    android:layout_height="fill_parent"
	    android:layout_weight="2"
	    android:text="@string/measure"
	    android:onClick="mixture_measure" />
    </LinearLayout>
    <TextView android:id="@+id/mixture_display"
	style="@style/Tuner.Readout"
	android:layout_width="fill_parent"
	android:layout_height="wrap_content" />
	<TextView android:id="@+id/mixture_pitch"
	style="@style/Tuner.Readout"
	android:layout_width="fill_parent"
	android:layout_height="wrap_content"
	android:textColor="@color/text_muted" />
    <TextView android:id="@+id/mixture_status"
	style="@style/Tuner.Caption"
	android:layout_width="fill_parent"
	android:layout_height="wrap_content"
	android:paddingBottom="4dp" />
    <LinearLayout
	android:layout_width="fill_parent"
	android:layout_height="1dp"
	android:layout_weight="1"
	android:orientation="horizontal">
	<Button android:id="@+id/mixture_semi_minus"
	    style="@style/Tuner.Button.Panel"
	    android:layout_width="1dp"
	    android:layout_height="fill_parent"
	    android:layout_weight="1"
	    android:text="@string/semi_minus"
	    android:onClick="mixture_semi_decr" />
	<Button
	    style="@style/Tuner.Button.Panel"
	    android:layout_width="1dp"
	    android:layout_height="fill_parent"
	    android:layout_weight="1"
	    android:text="@string/oct_minus"
	    android:onClick="mixture_oct_decr" />
	<Button android:id="@+id/mixture_reset"
	    style="@style/Tuner.Button.Panel"
	    android:layout_width="1dp"
	    android:layout_height="fill_parent"
	    android:layout_weight="2"
	    android:text="@string/reset"
	    android:textColor="@color/warn"
	    android:onClick="mixture_reset" />
    </LinearLayout>
</LinearLayout>
