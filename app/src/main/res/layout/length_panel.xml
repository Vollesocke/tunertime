<?xml version="1.0" encoding="utf-8"?>
<!-- length mode readout, added below the strobes in organ mode: only
     the length to cut off or to add, big, across the full width; the
     pipe controls below -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="horizontal"
    android:layout_width="fill_parent"
    android:layout_height="wrap_content">
    <include layout="@layout/length_controls"
	android:layout_width="0dp"
	android:layout_height="wrap_content"
	android:layout_weight="1" />
    <TextView android:id="@+id/length_display"
	style="@style/Tuner.Readout"
	android:layout_width="0dp"
	android:layout_height="wrap_content"
	android:layout_weight="2"
	android:maxLines="1"
	android:autoSizeMaxTextSize="28sp" />
</LinearLayout>
