<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_height="fill_parent"
    android:layout_width="fill_parent">
    <LinearLayout
	android:orientation="horizontal"
	android:layout_width="fill_parent"
	android:layout_height="1dp"
	android:layout_weight="1">
	<Button
	    style="@style/Tuner.Button.Panel"
	    android:layout_width="1dp"
	    android:layout_height="fill_parent"
	    android:layout_weight="1"
	    android:text="+1"
	    android:onClick="A_incr1" />
	<Button
	    style="@style/Tuner.Button.Panel"
	    android:layout_width="1dp"
	    android:layout_height="fill_parent"
	    android:layout_weight="1"
	    android:text="+0.1"
	    android:onClick="A_incrp1" />
    </LinearLayout>
    <TextView android:id="@+id/center_display2"
	style="@style/Tuner.Readout"
	android:layout_width="fill_parent"
	android:layout_height="wrap_content" />
    <LinearLayout
	android:orientation="horizontal"
	android:layout_width="fill_parent"
	android:layout_height="1dp"
	android:layout_weight="1">
	<Button
	    style="@style/Tuner.Button.Panel"
	    android:layout_width="1dp"
	    android:layout_height="fill_parent"
	    android:layout_weight="1"
	    android:text="-1"
	    android:onClick="A_decr1" />
	<Button
	    style="@style/Tuner.Button.Panel"
	    android:layout_width="1dp"
	    android:layout_height="fill_parent"
	    android:layout_weight="1"
	    android:text="-0.1"
	    android:onClick="A_decrp1" />
    </LinearLayout>
    <Button
	style="@style/Tuner.Button.Panel"
	android:layout_height="1dp"
	android:layout_width="fill_parent"
	android:layout_weight="1"
	android:text="@string/reset"
	android:textColor="@color/warn"
	android:onClick="reset_afreq" />
</LinearLayout>
