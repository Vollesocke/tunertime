<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:fitsSystemWindows="true"
    android:orientation="horizontal"
    android:layout_height="fill_parent"
    android:layout_width="fill_parent"
    >
    <!-- the strobe (or the preset workbench) with, in preset mode, its
	 navigation below; as layout/main.xml, which TunerTime expects -->
    <LinearLayout
	android:orientation="vertical"
	android:layout_height="fill_parent"
	android:layout_width="1dp"
	android:layout_weight="5">
	<!-- vertical, so the strobe-mode tab bar added below the surface
	     never covers the bottom strobe row -->
	<LinearLayout android:id="@+id/surface_frame"
	    android:orientation="vertical"
	    android:layout_width="fill_parent"
	    android:layout_height="1dp"
	    android:layout_weight="1">
	    <SurfaceView android:id="@+id/strobe"
		android:layout_width="fill_parent"
		android:layout_height="1dp"
		android:layout_weight="1" />
	</LinearLayout>
	<FrameLayout android:id="@+id/preset_nav_holder"
	    android:layout_width="fill_parent"
	    android:layout_height="wrap_content"
	    android:minHeight="56dp"
	    android:visibility="gone" />
    </LinearLayout>
    <LinearLayout android:id="@+id/controls_frame"
	android:layout_height="fill_parent"
	android:layout_width="1dp"
	android:layout_weight="2"
	android:orientation="vertical">
	<FrameLayout android:id="@+id/buttons_holder"
	    android:layout_height="1dp"
	    android:layout_width="fill_parent"
	    android:layout_weight="3" />
	<LinearLayout android:id="@+id/main_controls_side"
	    android:layout_height="1dp"
	    android:layout_width="fill_parent"
	    android:layout_weight="1"
	    android:orientation="vertical">
	    <LinearLayout
		android:layout_height="wrap_content"
		android:layout_width="fill_parent"
		android:orientation="horizontal">
		<TextView android:id="@+id/center_display"
		    style="@style/Tuner.Readout.Status"
		    android:layout_width="1dp"
		    android:layout_height="wrap_content"
		    android:layout_weight="1"
		    android:paddingLeft="8dp"
		    android:gravity="left" />
		<TextView android:id="@+id/stretch_display"
		    style="@style/Tuner.Readout.Status"
		    android:layout_width="1dp"
		    android:layout_height="wrap_content"
		    android:layout_weight="1"
		    android:paddingRight="8dp"
		    android:gravity="right" />
	    </LinearLayout>
	    <FrameLayout android:id="@+id/mode_holder"
		android:layout_width="fill_parent"
		android:layout_height="1dp"
		android:layout_weight="1" />
	</LinearLayout>
    </LinearLayout>
</LinearLayout>
