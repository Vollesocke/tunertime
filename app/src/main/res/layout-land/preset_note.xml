<?xml version="1.0" encoding="utf-8"?>
<!-- landscape: the keys, the cents field and the buttons on the left,
     the number pad on the right -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:fitsSystemWindows="true"
    android:orientation="horizontal"
    android:layout_width="fill_parent"
    android:layout_height="fill_parent">
    <LinearLayout
	android:orientation="vertical"
	android:layout_width="1dp"
	android:layout_weight="1"
	android:layout_height="fill_parent">
	<TextView android:id="@+id/pn_text"
	    android:layout_width="wrap_content"
	    android:layout_height="wrap_content"
	    android:layout_gravity="center_horizontal"
	    android:fontFamily="monospace"
	    android:textStyle="bold"
	    android:paddingTop="4dp"
	    android:paddingBottom="4dp"
	    android:textColor="@color/text"
	    android:textSize="28sp" />
	<org.galexander.tunertime.PianoKeyboard android:id="@+id/pn_keys"
	    android:layout_width="fill_parent"
	    android:layout_height="1dp"
	    android:layout_weight="1"
	    android:layout_marginLeft="8dp"
	    android:layout_marginRight="8dp" />
	<LinearLayout
	    android:orientation="horizontal"
	    android:layout_width="fill_parent"
	    android:layout_height="wrap_content"
	    android:paddingTop="4dp"
	    android:paddingBottom="4dp">
	    <TextView
		android:layout_width="wrap_content"
		android:layout_height="wrap_content"
		android:layout_gravity="center_vertical"
		android:paddingLeft="12dp"
		android:textAppearance="?android:attr/textAppearanceMedium"
		android:text="@string/cents_label" />
	    <EditText android:id="@+id/pn_cents"
		android:layout_width="1dp"
		android:layout_weight="1"
		android:layout_height="wrap_content"
		android:layout_marginLeft="8dp"
		android:layout_marginRight="12dp"
		android:minHeight="48dp"
		android:gravity="end|center_vertical"
		android:textAppearance="?android:attr/textAppearanceLarge"
		android:fontFamily="monospace"
		android:hint="0"
		android:lines="1"
		android:singleLine="true"
		android:cursorVisible="true"
		android:inputType="numberSigned|numberDecimal"
		android:digits="0123456789-.,"
		android:background="@drawable/mb_selected" />
	</LinearLayout>
	<LinearLayout
	    android:orientation="horizontal"
	    android:layout_width="fill_parent"
	    android:layout_height="wrap_content">
	    <Button
		style="@style/Tuner.Button.Big"
		android:layout_width="1dp"
		android:layout_weight="1"
		android:layout_height="wrap_content"
		android:minHeight="48dp"
		android:textColor="@color/warn"
		android:text="@string/delete_note"
		android:onClick="do_delete" />
	    <Button
		style="@style/Tuner.Button.Big"
		android:layout_width="1dp"
		android:layout_weight="1"
		android:layout_height="wrap_content"
		android:minHeight="48dp"
		android:text="@string/save"
		android:onClick="do_save" />
	</LinearLayout>
    </LinearLayout>
    <include layout="@layout/pn_pad"
	android:layout_width="1dp"
	android:layout_weight="1"
	android:layout_height="fill_parent" />
</LinearLayout>
