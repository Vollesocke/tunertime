<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="horizontal"
    android:layout_width="fill_parent"
    android:layout_height="fill_parent">
    <Button android:id="@+id/auto_button"
	style="@style/Tuner.Button.Panel"
	android:layout_width="1dp"
	android:layout_height="fill_parent"
	android:layout_weight="1"
	android:text="@string/auto"
	android:onClick="do_auto" />
    <ImageButton android:id="@+id/tone_button"
	style="@style/Tuner.Button.Panel"
	android:layout_width="1dp"
	android:layout_height="fill_parent"
	android:layout_weight="1"
	android:src="@drawable/ic_volume"
	android:contentDescription="@string/tone"
	android:scaleType="fitCenter"
	android:paddingTop="6dp"
	android:paddingBottom="6dp"
	android:onClick="do_tone" />
    <Button android:id="@+id/mode_button"
	style="@style/Tuner.Button.Panel"
	android:layout_width="1dp"
	android:layout_height="fill_parent"
	android:layout_weight="1"
	android:text="@string/mode_fft"
	android:textColor="@color/accent"
	android:onClick="do_mode" />
</LinearLayout>
